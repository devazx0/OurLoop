# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/ourloop?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/ourloop?schema=public"

# Supabase Storage (Optional locally, used in production)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# JWT Secret / Auth Secret
AUTH_SECRET="your-random-secret-key-at-least-32-chars"

# Google OAuth
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
NEXT_PUBLIC_APP_URL="http://localhost:6003"

# Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:support@ourloop.app"

# Resend — email notifications for new messages
# Get a key at https://resend.com/api-keys. Send from a verified domain so
# emails reach your partner (or use onboarding@resend.dev to test with the
# Resend account owner's own address).
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM_EMAIL="OurLoop <notifications@your-verified-domain.com>"
